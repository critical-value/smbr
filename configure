#!/bin/sh
set -eu
: "${R_HOME:=$(R RHOME)}"
CPPFLAGS="${CPPFLAGS:-}"
LIBS="${LIBS:-}"

SMBR_SAMBA_PREFIX="${SMBR_SAMBA_PREFIX:-}"
SMBR_SAMBA_INCLUDEDIR=""
SMBR_SAMBA_LIBDIR=""
SMBR_SAMBA_PREFIX_PKGCONFIG=0

if [ -n "$SMBR_SAMBA_PREFIX" ]; then
  if [ -d "$SMBR_SAMBA_PREFIX/include" ]; then
    SMBR_SAMBA_INCLUDEDIR="$SMBR_SAMBA_PREFIX/include"
  fi
  if [ -d "$SMBR_SAMBA_PREFIX/lib" ]; then
    SMBR_SAMBA_LIBDIR="$SMBR_SAMBA_PREFIX/lib"
  elif [ -d "$SMBR_SAMBA_PREFIX/lib64" ]; then
    SMBR_SAMBA_LIBDIR="$SMBR_SAMBA_PREFIX/lib64"
  fi

  if [ -d "$SMBR_SAMBA_LIBDIR/pkgconfig" ]; then
    if [ -f "$SMBR_SAMBA_LIBDIR/pkgconfig/smbclient.pc" ]; then
      SMBR_SAMBA_PREFIX_PKGCONFIG=1
    fi
    if [ -n "${PKG_CONFIG_PATH:-}" ]; then
      PKG_CONFIG_PATH="$SMBR_SAMBA_LIBDIR/pkgconfig:$PKG_CONFIG_PATH"
    else
      PKG_CONFIG_PATH="$SMBR_SAMBA_LIBDIR/pkgconfig"
    fi
    export PKG_CONFIG_PATH
  fi
fi

if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists smbclient; then
  CFLAGS=$(pkg-config --cflags smbclient)
  LDLIBS=$(pkg-config --libs smbclient)
  if [ "$SMBR_SAMBA_PREFIX_PKGCONFIG" -eq 1 ]; then
    case "$(uname -s)" in
      Darwin|Linux) LDLIBS="$LDLIBS -Wl,-rpath,$SMBR_SAMBA_LIBDIR" ;;
    esac
  fi
elif [ -n "$SMBR_SAMBA_INCLUDEDIR" ] && [ -n "$SMBR_SAMBA_LIBDIR" ] && [ -f "$SMBR_SAMBA_INCLUDEDIR/libsmbclient.h" ]; then
  CFLAGS="-I$SMBR_SAMBA_INCLUDEDIR"
  LDLIBS="-L$SMBR_SAMBA_LIBDIR -lsmbclient"
  case "$(uname -s)" in
    Darwin|Linux) LDLIBS="$LDLIBS -Wl,-rpath,$SMBR_SAMBA_LIBDIR" ;;
  esac
elif [ -f /usr/include/libsmbclient.h ]; then
  CFLAGS=""
  LDLIBS="-lsmbclient"
elif [ -f /usr/local/include/libsmbclient.h ]; then
  CFLAGS=""
  LDLIBS="-lsmbclient"
elif [ -f /opt/homebrew/include/libsmbclient.h ]; then
  CFLAGS="-I/opt/homebrew/include"
  LDLIBS="-L/opt/homebrew/lib -lsmbclient"
else
  echo "ERROR: smbr requires Samba libsmbclient development files." >&2
  echo "Install libsmbclient-dev (Debian/Ubuntu) or the equivalent package." >&2
  echo "Or set SMBR_SAMBA_PREFIX to a user-local Samba installation." >&2
  exit 1
fi
sed -e "s|@SMBCLIENT_CFLAGS@|$CFLAGS|" -e "s|@SMBCLIENT_LIBS@|$LDLIBS|" src/Makevars.in > src/Makevars
